{
  "name": "@stuhelper/engineering-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "check:docs": "node tooling/cli.mjs docs",
    "test:docs": "node --test tooling/docs/check-docs.test.mjs",
    "test:e2e": "playwright test",
    "test:tools": "node --test tooling/*.test.mjs tooling/docs/check-docs.test.mjs tooling/i18n/check-i18n.test.mjs && python3 -m unittest discover -s tooling -p \"test_*.py\""
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "packageManager": "pnpm@10.33.4",
  "version": "0.1.1",
  "files": [
    "tooling",
    "architecture/modules.json",
    "architecture/locales.json",
    "architecture/toolchains.json",
    "docs/spec/terminology.md"
  ],
  "bin": {
    "stuhelper-check": "tooling/cli.mjs"
  },
  "exports": {
    "./docs": "./tooling/docs/check-docs.mjs",
    "./i18n": "./tooling/i18n/check-i18n.mjs"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.3",
    "markdownlint": "0.42.0",
    "picomatch": "4.0.7",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "katex": "0.18.2"
    }
  }
}
